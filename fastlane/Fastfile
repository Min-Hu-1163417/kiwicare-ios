default_platform(:ios)

PROJECT = "KiwiCare.xcodeproj"
SCHEME = "KiwiCare"
TEST_DEVICE = ENV.fetch("TEST_DEVICE", "iPhone 17")

platform :ios do

  desc "Run unit tests on the simulator"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: TEST_DEVICE,
      only_testing: ["KiwiCareTests"],
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      result_bundle: true,
      output_types: "html,junit",
      output_directory: "fastlane/test_output"
    )
  end

  desc "Build an unsigned Release archive"
  lane :build do
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      skip_codesigning: true,
      skip_package_ipa: true,
      archive_path: "build/KiwiCare.xcarchive"
    )
  end

  # 以后做 CD 时使用：需要付费开发者账号，以及 GitHub Secrets 里的配置
  desc "Sign the app and upload it to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(type: "appstore", readonly: true, api_key: api_key)

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key) + 1
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end